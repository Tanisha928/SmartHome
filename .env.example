ENV=dev
DATABASE_URL=postgresql+psycopg://smart:smart@postgres:5432/smarthome
MONGO_URL=mongodb://mongo:27017
MONGO_DB=smarthome
AWS_REGION=us-west-2
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=smarthome-clips
SQS_QUEUE_URL=http://localstack:4566/000000000000/inference-events
SQS_DLQ_URL=http://localstack:4566/000000000000/inference-events-dlq
SNS_TOPIC_PREFIX=house-
JWT_SECRET=change-me-in-production
JWT_ALG=HS256
ACCESS_TOKEN_MIN=30
REFRESH_TOKEN_DAYS=7
DEVICE_TOKEN_MIN=15
MAX_CLIP_MB=25
SIGNED_URL_TTL_SEC=300
OFFLINE_AFTER_MIN=10
CMD_EXPIRE_MIN=60
DUP_WINDOW_SEC=60
ESCALATE_AFTER_MIN=5
DEFAULT_THRESHOLD=0.80
SNS_RETRY_SECONDS=5,15,45
CLASSIFIER=mock
INTERNAL_API_ENABLED=true
INTERNAL_API_KEY=dev-internal
CORS_ORIGINS=http://localhost:5173
TELEMETRY_TTL_DAYS=30
