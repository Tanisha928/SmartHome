{
  "openapi": "3.1.0",
  "info": {
    "title": "Smart Home Platform API",
    "version": "0.2.0",
    "description": "Frozen stub for MSW / openapi-typescript. Regenerate from a running backend with `make openapi`."
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/signup": {
      "post": {
        "summary": "Signup owner",
        "responses": { "201": { "description": "Created" }, "409": { "description": "Duplicate email" } }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Login",
        "responses": { "200": { "description": "Tokens" }, "401": { "description": "Bad credentials" }, "429": { "description": "Rate limited" } }
      }
    },
    "/api/auth/refresh": { "post": { "summary": "Refresh access token", "responses": { "200": { "description": "OK" } } } },
    "/api/auth/logout": { "post": { "summary": "Logout", "responses": { "204": { "description": "Cleared" } } } },
    "/api/users/me": {
      "get": { "summary": "Current user", "responses": { "200": { "description": "Profile" } } },
      "put": { "summary": "Update profile", "responses": { "200": { "description": "Profile" } } }
    },
    "/api/users/me/saved-views": {
      "get": { "summary": "Saved views", "responses": { "200": { "description": "OK" } } },
      "put": { "summary": "Replace saved views", "responses": { "200": { "description": "OK" } } }
    },
    "/api/users/me/dashboard-settings": {
      "get": { "summary": "Get dashboard settings", "responses": { "200": { "description": "Dashboard settings" } } },
      "put": { "summary": "Update dashboard settings", "responses": { "200": { "description": "Updated dashboard settings" } } }
    },
    "/api/houses": {
      "get": { "summary": "List houses", "responses": { "200": { "description": "Paged" } } },
      "post": { "summary": "Create house", "responses": { "201": { "description": "Created" }, "409": { "description": "Duplicate" } } }
    },
    "/api/houses/{house_id}": {
      "get": { "summary": "House detail", "parameters": [{ "name": "house_id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "OK" } } }
    },
    "/api/ingest/events": {
      "post": { "summary": "Ingest clip", "responses": { "202": { "description": "Queued" }, "200": { "description": "Duplicate" }, "403": { "description": "Scope" }, "413": { "description": "Too large" }, "503": { "description": "Storage down" } } }
    },
    "/api/events/{event_id}": {
      "get": { "summary": "Event status", "parameters": [{ "name": "event_id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "OK" } } }
    },
    "/api/admin/data/health": { "get": { "summary": "Data plane health", "responses": { "200": { "description": "OK" } } } },
    "/api/admin/events": { "get": { "summary": "Admin event pipeline", "responses": { "200": { "description": "OK" } } } },
    "/api/admin/events/{event_id}/retry": {
      "post": { "summary": "Retry event", "parameters": [{ "name": "event_id", "in": "path", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "OK" }, "409": { "description": "Already scored" } } }
    },
    "/api/admin/inference-logs": { "get": { "summary": "Inference explorer", "responses": { "200": { "description": "OK" } } } },
    "/api/admin/audit": { "get": { "summary": "Admin audit log", "responses": { "200": { "description": "OK" } } } },
    "/api/admin/retention": {
      "get": { "summary": "Get retention policy", "responses": { "200": { "description": "OK" } } },
      "put": { "summary": "Update retention policy", "responses": { "200": { "description": "OK" }, "400": { "description": "Invalid range" } } }
    },
    "/api/alerts": { "get": { "summary": "List scoped alerts", "responses": { "200": { "description": "Scoped paginated alerts" }, "403": { "description": "House out of scope" } } } },
    "/api/alerts/{alert_id}": { "get": { "summary": "Alert detail with history and deliveries", "responses": { "200": { "description": "Alert detail" }, "403": { "description": "House out of scope" } } } },
    "/api/alerts/{alert_id}/state": { "patch": { "summary": "Transition alert state", "responses": { "200": { "description": "Updated alert" }, "409": { "description": "Stale state conflict" }, "422": { "description": "Invalid transition" } } } },
    "/api/alerts/{alert_id}/resend": { "post": { "summary": "Resend failed notifications", "responses": { "200": { "description": "Accepted" }, "403": { "description": "Admin required" } } } },
    "/api/alerts/export": { "get": { "summary": "Export alerts as CSV or PDF", "responses": { "200": { "description": "Download" } } } },
    "/api/stats/alerts": { "get": { "summary": "Alert statistics", "responses": { "200": { "description": "Counts by severity, category, and state" } } } },
    "/api/stats/false-alerts": { "get": { "summary": "False-alert statistics", "responses": { "200": { "description": "False-positive rates and low-sample flags" } } } },
    "/api/notification-prefs": { "get": { "summary": "Get notification preferences", "responses": { "200": { "description": "Notification matrix" } } }, "put": { "summary": "Update notification preferences", "responses": { "200": { "description": "Updated matrix" } } } },
    "/api/admin/thresholds": { "get": { "summary": "List thresholds", "responses": { "200": { "description": "Threshold overrides" } } }, "put": { "summary": "Update threshold", "responses": { "200": { "description": "Updated threshold" }, "403": { "description": "Admin required" } } } },
    "/internal/inference-results": { "post": { "summary": "Apply internal inference result", "responses": { "200": { "description": "Policy decision" }, "403": { "description": "Internal key required" } } } },
    "/ws/alerts": { "get": { "summary": "House-scoped alert WebSocket", "responses": { "101": { "description": "Switching protocols" }, "1008": { "description": "Unauthorized or out of scope" } } } }
  }
}
