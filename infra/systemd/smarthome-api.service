[Unit]
Description=Smart Home API (uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=smarthome
WorkingDirectory=/opt/smarthome/backend
EnvironmentFile=/etc/smarthome.env
ExecStart=/opt/smarthome/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
